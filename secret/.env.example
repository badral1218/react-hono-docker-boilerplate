# back
BACK_PORT=8000

DB_USER="tmp_user"
DB_PASS="tmp_password"
DB_HOST="localhost"
DB_NAME="tmp_local"
DB_PORT=5431

# Composed connection string used by the API (Prisma) for local dev.
# In Docker this is overridden by docker-compose (host "db", port 5432).
DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
