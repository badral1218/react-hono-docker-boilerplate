{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.md",
      "!**/*.gen.*",
      "!**/generated/**/*",
      "!**/api/public/**/*",
      "!**/dist/**/*",
      "!**/.tanstack/tmp/**/*",
      "!logs/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    },
    "includes": ["**", "!**/tailwind.css"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
