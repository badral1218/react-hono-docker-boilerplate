{
  "name": "@react-template/db",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "bun --bun run --env-file ../../secret/.env prisma generate",
    "migrate": "bun --bun run --env-file ../../secret/.env prisma migrate deploy",
    "migrate-dev": "bun --bun run --env-file ../../secret/.env prisma migrate dev --name added-order",
    "reset": "bun --bun run --env-file ../../secret/.env prisma migrate reset -f",
    "init": "bun --bun run --env-file ../../secret/.env prisma migrate dev --name init",
    "seed": "bun --bun run --env-file ../../secret/.env prisma db seed",
    "studio": "bun --bun run --env-file ../../secret/.env prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  }
}
