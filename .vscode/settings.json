{
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.wordWrapColumn": 100,
    "editor.rulers": [100],
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit"
    }
  },

  "[typescript]": {
    "editor.tabSize": 2,
    "editor.wordWrapColumn": 100,
    "editor.rulers": [100],
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit"
    }
  },
  "[python]": {
    "editor.wordWrapColumn": 119,
    "editor.rulers": [119]
  },
  "[html]": { "editor.tabSize": 2 },
  "[css]": { "editor.tabSize": 2 },
  "[scss]": { "editor.tabSize": 2 },
  "[less]": { "editor.tabSize": 2 },
  "[json]": {
    "files.insertFinalNewline": false,
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.tabSize": 2
  },
  "[yaml]": { "editor.tabSize": 2 },
  "[toml]": { "editor.tabSize": 2 },
  "[dockerfile]": { "editor.tabSize": 2 },
  "[shellscript]": { "editor.tabSize": 2 },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": "off"
    },
    "editor.tabSize": 2,
    "files.trimTrailingWhitespace": false,
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80]
  },
  "[plaintext]": {
    "editor.wordWrapColumn": 79,
    "editor.rulers": [79]
  },
  "[makefile]": {
    "editor.insertSpaces": false
  },
  "[bat]": {
    "editor.insertSpaces": false
  },
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "javascript.format.enable": false,
  "js/ts.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
  "js/ts.preferences.quoteStyle": "double",
  "npm.packageManager": "bun",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.format.enable": false,
  "typescript.tsdk": "node_modules/typescript/lib"
}
