{
  "name": "react-template",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev dev:rpc --parallel",
    "build": "turbo run build",
    "build:rpc": "turbo run build:rpc",
    "run:db": "cd packages/db && bun",
    "prepare": "bun scripts/husky",
    "lint": "biome check --write .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "turbo": "^2.5.8"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  }
}
